---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const papers = await getCollection('papers');
const blogPosts = await getCollection('blog');

const latestPaper = papers.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const recentPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const hardwareTiers = [
  {
    tier: 'Apple Silicon (M1/M2/M3/M4/M5)',
    runtime: 'oMLX Mixed Precision (oQ4e / oQ6e / oQ8e) + Metal MTP',
    context: '1,048,576 Context (2^20) in 17GB–30GB RAM',
    throughput: '180+ tok/s (MTP Speculative Heads)',
    target: 'Native Developer Workstations & Mac Studios',
  },
  {
    tier: 'NVIDIA Blackwell & Ada (RTX 4090 / 5090 / L40S)',
    runtime: 'Anvil Engine + NVFP4 Microscaling',
    context: '1,048,576 Context in ~18 GB VRAM (TurboQuant)',
    throughput: '140+ tok/s (NVFP4 Tensor Cores)',
    target: 'On-Premise Engineering Desktops & Air-Gapped Labs',
  },
  {
    tier: 'Universal Enterprise (A100 / H100 / B200 / MI300X)',
    runtime: 'vLLM / SGLang OCP MXFP4 Engine',
    context: '1,048,576 Batch Concurrency',
    throughput: '450+ tok/s batch throughput',
    target: 'Private Sovereign Clusters & Cloud VPCs',
  },
  {
    tier: 'Tactical Edge (Jetson Orin Nano / AGX)',
    runtime: 'Anvil Embedded GGUF + mmproj-BF16',
    context: '64k context under 15W envelope',
    throughput: '45+ tok/s edge multimodal inference',
    target: 'Field Robotics & Disconnected Autonomous Systems',
  },
];
---

<Layout title="Solstice-AI — Frontier Intelligence Infrastructure">

  <!-- ═══════════════ 1. HERO WRAPPER (PRISMML ARCHITECTURE) ═══════════════ -->
  <section class="section hero-section border-bottom">
    <div class="container">
      <div class="hero-single-box">
        <div class="hero-intro-box">
          <div class="hero-eyebrow mono">
            <span class="eyebrow-tag">SOLSTICE-AI</span>
            <span class="eyebrow-dot">&bull;</span>
            <span>SOVEREIGN INTELLIGENCE INFRASTRUCTURE</span>
          </div>
          <h1>Efficient intelligence.<br/><span class="hero-hl">Built for the real world.</span></h1>
          <p class="hero-intro-text">
            Frontier AI for everyone, everywhere.
          </p>
          <div class="hero-btn-row">
            <a href="/docs/quantized-models-quickstart" class="btn solid">
              <div class="btn-inner">
                <span class="btn-text">Explore Models</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
            <a href="https://huggingface.co/Solstice-AI" target="_blank" rel="noopener noreferrer" class="btn rose">
              <div class="btn-inner">
                <span class="btn-text">Hugging Face Hub</span>
                <span class="btn-arrow">↗</span>
              </div>
            </a>
            <a href="/company#contact" class="btn">
              <div class="btn-inner">
                <span class="btn-text">Deploy Sovereign</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Supporter / Lab Attribution Strip -->
        <div class="attributions-strip mono">
          <div class="attr-label">Supported Frameworks & Environments:</div>
          <div class="attr-items">
            <span>Anvil (llama.cpp)</span>
            <span>&bull;</span>
            <span>TurboQuant MLX (Metal)</span>
            <span>&bull;</span>
            <span>vLLM (FP8)</span>
            <span>&bull;</span>
            <span>Hugging Face TRL</span>
            <span>&bull;</span>
            <span>Axolotl</span>
          </div>
        </div>
      </div>

      <!-- 3 Open Infrastructure Pillars (3-Column Row) -->
      <div class="hero-pillars-3col">
        <div class="pillar-col">
          <div class="pillar-top mono">
            <span class="pillar-idx">01</span>
            <span class="pillar-badge rose">DISTILLATION</span>
          </div>
          <h3>Multi-Teacher Corpora</h3>
          <p>Solace 1.0 Omni (12.59M conversations, 137.7 GB) and Project Axiom (102 GB CoT) synthesized across 7 frontier architectures.</p>
          <div class="pillar-foot mono">
            <span class="tag-chip">12.59M Rows</span>
            <span class="tag-chip">137.7 GB</span>
            <a href="https://huggingface.co/datasets/Solstice-AI/Solace-1.0-Omni" target="_blank" rel="noopener noreferrer" class="pillar-link">Hugging Face ↗</a>
          </div>
        </div>

        <div class="pillar-col">
          <div class="pillar-top mono">
            <span class="pillar-idx">02</span>
            <span class="pillar-badge amber">MODELS</span>
          </div>
          <h3>19 Flagship Checkpoints</h3>
          <p>Blackwell NVFP4, OCP MXFP4, Apple MLX Mixed Precision (oQ8e, oQ6e, oQ4e), and GGUF DiMatrix with baked-in MTP speculative heads.</p>
          <div class="pillar-foot mono">
            <span class="tag-chip">19 Models</span>
            <span class="tag-chip">NVFP4 & MLX</span>
            <a href="/docs/quantized-models-quickstart" class="pillar-link">Model Guides →</a>
          </div>
        </div>

        <div class="pillar-col">
          <div class="pillar-top mono">
            <span class="pillar-idx">03</span>
            <span class="pillar-badge">RUNTIME</span>
          </div>
          <h3>1,048,576 Token Context (2^20)</h3>
          <p>Compress 1M token context on Qwen 3.8 into ~12–18 GB VRAM via Anvil and Google TurboQuant (FWHT + QJL residual quantization).</p>
          <div class="pillar-foot mono">
            <span class="tag-chip">1M in 14GB</span>
            <span class="tag-chip">Anvil & MLX</span>
            <a href="/docs/turboquant-anvil-guide" class="pillar-link">Engine Guide →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 2. ENTERPRISE SOLUTIONS & INDUSTRY VERTICALS (CLIENT FOCUS) ═══════════════ -->
  <section class="section border-bottom" id="solutions">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow">Enterprise Solutions</span>
          <h2>Engineered for High-Assurance Environments</h2>
        </div>
        <p>
          Solstice bridges the gap between frontier reasoning and sovereign local execution for organizations that cannot compromise on privacy, cost, or uptime.
        </p>
      </div>

      <div class="solutions-grid">
        <div class="sol-card">
          <div class="sol-top mono">
            <span class="sol-badge rose">TACTICAL & DEFENSE</span>
            <span class="sol-idx">01</span>
          </div>
          <h3>Autonomous Edge Systems</h3>
          <p>
            Deploy sub-8B distilled reasoning agents on disconnected, ruggedized hardware (NVIDIA Jetson / Mac Studio). Full tool orchestration and mission planning with zero cloud dependencies.
          </p>
          <ul class="sol-list mono">
            <li><span>Egress:</span> <strong>100% Air-Gapped</strong></li>
            <li><span>Latency:</span> <strong>Sub-25ms Local Execution</strong></li>
            <li><span>Hardware:</span> <strong>Commodity Edge Workstations</strong></li>
          </ul>
        </div>

        <div class="sol-card">
          <div class="sol-top mono">
            <span class="sol-badge amber">BIO-PHARMA & GENOMICS</span>
            <span class="sol-idx">02</span>
          </div>
          <h3>Computational Biology</h3>
          <p>
            Single-cell transcriptomics (scRNA-seq), genomic sequence annotation, and clinical synthesis run directly on internal hospital clusters with strict HIPAA & PHI isolation.
          </p>
          <ul class="sol-list mono">
            <li><span>Compliance:</span> <strong>Zero External Data Sharing</strong></li>
            <li><span>Precision:</span> <strong>High-Precision Q8 Inference</strong></li>
            <li><span>Workload:</span> <strong>Large-Scale Batch Phenotyping</strong></li>
          </ul>
        </div>

        <div class="sol-card">
          <div class="sol-top mono">
            <span class="sol-badge">FINANCE & LEGAL</span>
            <span class="sol-idx">03</span>
          </div>
          <h3>Private VPC Engineering</h3>
          <p>
            Unrestricted code refactoring, contract analysis, and quantitative modeling behind corporate VPCs. Eliminates third-party API rate limits, pricing hikes, and silent model drift.
          </p>
          <ul class="sol-list mono">
            <li><span>Cost:</span> <strong>85% Lower TCO vs Cloud APIs</strong></li>
            <li><span>Uptime:</span> <strong>Dedicated Local Compute SLA</strong></li>
            <li><span>Auditing:</span> <strong>Deterministic Fixed Checkpoints</strong></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 3. THE SOVEREIGN ADVANTAGE (ENTERPRISE VALUE GRID) ═══════════════ -->
  <section class="section border-bottom">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow">Enterprise Value</span>
          <h2>The Sovereign Intelligence Advantage</h2>
        </div>
        <p>
          Why institutional engineering teams, national labs, and frontier researchers build on Solstice instead of rented black-box APIs.
        </p>
      </div>

      <div class="advantage-grid-4col">
        <div class="adv-card">
          <div class="adv-top mono">
            <span class="adv-num">01</span>
            <span class="badge rose">ZERO EGRESS</span>
          </div>
          <h3>100% Data Confidentiality</h3>
          <p>
            Your prompts, proprietary codebases, patient records, and classified documents never traverse external internet pipes. Models run completely within your air-gapped security perimeter.
          </p>
        </div>

        <div class="adv-card">
          <div class="adv-top mono">
            <span class="adv-num">02</span>
            <span class="badge amber">COST CONTROL</span>
          </div>
          <h3>85% Lower TCO vs Cloud APIs</h3>
          <p>
            Eliminate recurring per-token cloud tolls. Run millions of synthetic reasoning passes, batch embeddings, and agent tool loops on local fixed-cost silicon with zero marginal fee.
          </p>
        </div>

        <div class="adv-card">
          <div class="adv-top mono">
            <span class="adv-num">03</span>
            <span class="badge">REPRODUCIBILITY</span>
          </div>
          <h3>Deterministic Open Checkpoints</h3>
          <p>
            Commercial cloud APIs quietly update, degrade, or deprecate model weights without notice. Solstice delivers fixed, verifiable checkpoints with cryptographic weight hashes for reproducible results.
          </p>
        </div>

        <div class="adv-card">
          <div class="adv-top mono">
            <span class="adv-num">04</span>
            <span class="badge rose">HIGH INTEGRITY</span>
          </div>
          <h3>Compiler-Verified Corpora</h3>
          <p>
            Every single trace in Solace 1.0 Omni passes rigorous compiler syntax execution, AST validation, and formal proof checkers before inclusion, eliminating phantom hallucinations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 4. INTERACTIVE BENCHMARK & DISTILLATION EXPLORER (PRISMML VIZ) ═══════════════ -->
  <section class="section border-bottom" id="benchmarks-section">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow">Interactive Benchmarks</span>
          <h2>Distillation & Compression Explorer</h2>
        </div>
        <p>
          Empirical memory footprints, deduplication efficiency, and community downloads across our open releases.
        </p>
      </div>

      <div class="prism-viz-wrapper">
        <!-- Visualizer Tab Bar -->
        <div class="viz-tab-bar mono">
          <button class="viz-tab-btn active" data-tab="composition">Corpus Breakdown</button>
          <button class="viz-tab-btn" data-tab="dedup">Deduplication Yield</button>
          <button class="viz-tab-btn" data-tab="turboquant">TurboQuant KV Cache</button>
          <button class="viz-tab-btn" data-tab="models">Hub Downloads</button>
        </div>

        <!-- Viz Content Panels -->
        <div class="viz-panel active" id="panel-composition">
          <div class="viz-header">
            <h3>Project Solace 1.0 Omni Composition</h3>
            <p class="mono">12,586,893 unique conversations synthesized from 60 audited sources across 7 frontier architectures</p>
          </div>
          <div class="viz-rule"></div>

          <!-- Benchmark Bar Chart Data -->
          <div class="chart-bars-list">
            <div class="chart-row">
              <div class="chart-lbl mono highlight">Qwen 3.8-Max & Multi-Teacher Reasoning</div>
              <div class="chart-track">
                <div class="chart-fill solace-fill" style="width: 34.5%;">
                  <span class="chart-val mono">4,342,000 (34.5%)</span>
                </div>
              </div>
            </div>

            <div class="chart-row">
              <div class="chart-lbl mono">GLM 5.2 (15 Sources &bull; Agent Rollouts & Regen)</div>
              <div class="chart-track">
                <div class="chart-fill teacher-fill" style="width: 18.9%;">
                  <span class="chart-val mono">2,380,000 (18.9%)</span>
                </div>
              </div>
            </div>

            <div class="chart-row">
              <div class="chart-lbl mono">GPT-5.6 Sol & GPT-5.5 Codex (Code & ARC-AGI3)</div>
              <div class="chart-track">
                <div class="chart-fill teacher-fill" style="width: 16.8%;">
                  <span class="chart-val mono">2,120,000 (16.8%)</span>
                </div>
              </div>
            </div>

            <div class="chart-row">
              <div class="chart-lbl mono">Claude Fable 5 & Mythos (Clean Agent Traces)</div>
              <div class="chart-track">
                <div class="chart-fill teacher-fill" style="width: 16.0%;">
                  <span class="chart-val mono">2,006,487 (16.0%)</span>
                </div>
              </div>
            </div>

            <div class="chart-row">
              <div class="chart-lbl mono">DeepSeek V4 Pro 0813 (Math/STEM & SWE)</div>
              <div class="chart-track">
                <div class="chart-fill teacher-fill" style="width: 13.8%;">
                  <span class="chart-val mono">1,738,406 (13.8%)</span>
                </div>
              </div>
            </div>
          </div>

          <div class="viz-footer mono">
            <span>Verified on Hugging Face: <a href="https://huggingface.co/datasets/Solstice-AI/Solace-1.0-Omni" target="_blank" rel="noopener noreferrer">Solstice-AI/Solace-1.0-Omni</a> (137.7 GB uncompressed / 34.3 GB gz).</span>
          </div>
        </div>

        <!-- Dedup Panel -->
        <div class="viz-panel" id="panel-dedup">
          <div class="viz-header">
            <h3>Exact SHA256 Deduplication Yield</h3>
            <p class="mono">Eliminating cross-dataset contamination and scraping redundancy</p>
          </div>
          <div class="viz-rule"></div>
          <div class="chart-bars-list">
            <div class="chart-row">
              <div class="chart-lbl mono">Raw Ingested Dataset Rows (60 Sources)</div>
              <div class="chart-track">
                <div class="chart-fill raw-fill" style="width: 100%;">
                  <span class="chart-val mono">16,032,427 (100%)</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono highlight">Exact SHA256 Duplicates Purged</div>
              <div class="chart-track">
                <div class="chart-fill baseline-fill" style="width: 21.5%;">
                  <span class="chart-val mono">3,445,534 (21.5% Redundant)</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono highlight">Final Clean Solace Yield</div>
              <div class="chart-track">
                <div class="chart-fill solace-fill" style="width: 78.5%;">
                  <span class="chart-val mono">12,586,893 Unique Conversations (78.5%)</span>
                </div>
              </div>
            </div>
          </div>
          <div class="viz-footer mono">
            <span>Guarantees zero verbatim duplicate contamination across downstream fine-tuning.</span>
          </div>
        </div>

        <!-- TurboQuant Panel -->
        <div class="viz-panel" id="panel-turboquant">
          <div class="viz-header">
            <h3>Google TurboQuant 1,048,576 Token KV Cache Compression</h3>
            <p class="mono">Memory footprint at 1M ($2^{20}$) context on NVIDIA RTX 4090 / Apple M4 Max</p>
          </div>
          <div class="viz-rule"></div>
          <div class="chart-bars-list">
            <div class="chart-row">
              <div class="chart-lbl mono">Uncompressed FP16 1M KV Cache (2x A100 Required)</div>
              <div class="chart-track">
                <div class="chart-fill raw-fill" style="width: 100%;">
                  <span class="chart-val mono">88.4 GB (OOM on Single GPU)</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono">Standard FP8 1M KV Cache</div>
              <div class="chart-track">
                <div class="chart-fill baseline-fill" style="width: 50%;">
                  <span class="chart-val mono">44.2 GB (Exceeds Consumer 24GB GPUs)</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono highlight">TurboQuant 3-bit / 4-bit FWHT (Anvil Engine)</div>
              <div class="chart-track">
                <div class="chart-fill solace-fill" style="width: 14%;">
                  <span class="chart-val mono">12.4 GB (-86% Footprint &bull; Runs on Single 24GB GPU)</span>
                </div>
              </div>
            </div>
          </div>
          <div class="viz-footer mono">
            <span>Fast Walsh-Hadamard Transform (FWHT) + QJL vector quantization enables million-token inference on desktop hardware.</span>
          </div>
        </div>

        <!-- Models Panel -->
        <div class="viz-panel" id="panel-models">
          <div class="viz-header">
            <h3>Published Checkpoints on Hugging Face Hub</h3>
            <p class="mono">Full catalog across Blackwell NVFP4, OCP MXFP4, Apple MLX, and GGUF</p>
          </div>
          <div class="viz-rule"></div>
          <div class="chart-bars-list">
            <div class="chart-row">
              <div class="chart-lbl mono highlight">Qwen3.8-27B-TURBO-NVFP4-1M (1,048,576 Tokens)</div>
              <div class="chart-track">
                <div class="chart-fill solace-fill" style="width: 95%;">
                  <span class="chart-val mono">18.8 GB &bull; Native Blackwell NVFP4 + MTP</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono highlight">Qwen3.8-27B-TURBO-MXFP4-1M (1,048,576 Tokens)</div>
              <div class="chart-track">
                <div class="chart-fill solace-fill" style="width: 90%;">
                  <span class="chart-val mono">18.0 GB &bull; Universal OCP MXFP4 + MTP</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono highlight">Qwen3.8-27B-TURBO-mlx-oQ4e-1M (1,048,576 Tokens)</div>
              <div class="chart-track">
                <div class="chart-fill solace-fill" style="width: 85%;">
                  <span class="chart-val mono">17.0 GB &bull; 2.20x Generation Speed on 16GB Macs</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono">Qwen3.8-27B-TURBO-mlx-oQ8e-1M (1,048,576 Tokens)</div>
              <div class="chart-track">
                <div class="chart-fill teacher-fill" style="width: 75%;">
                  <span class="chart-val mono">30.0 GB &bull; 89.6% HumanEval Reference Grade</span>
                </div>
              </div>
            </div>
            <div class="chart-row">
              <div class="chart-lbl mono">Qwen3.8-27B-TURBO-GGUF-UltraOptimised (424 GB)</div>
              <div class="chart-track">
                <div class="chart-fill teacher-fill" style="width: 65%;">
                  <span class="chart-val mono">Complete Matrix Q8_0 &rarr; IQ4_XS + mmproj-BF16</span>
                </div>
              </div>
            </div>
          </div>
          <div class="viz-footer mono">
            <span>Explore all checkpoints directly at <a href="https://huggingface.co/Solstice-AI" target="_blank" rel="noopener noreferrer">huggingface.co/Solstice-AI</a>.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 5. CORE INFRASTRUCTURE MATRIX ROWS (PRISMML ARCHITECTURE) ═══════════════ -->
  <section class="section border-bottom">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow">Architecture & Tooling</span>
          <h2>Open Infrastructure Stack</h2>
        </div>
        <p>
          We provide every layer of the post-training distillation stack as open, reproducible artifacts.
        </p>
      </div>

      <div class="arch-rows-list">
        <div class="arch-row">
          <div class="arch-index mono">01</div>
          <div class="arch-main">
            <h3>Multi-Teacher Reasoning Corpora</h3>
            <p>
              Uncensored chain-of-thought, code refactoring transcripts, and agentic sandbox tool invocations. All datasets are partitioned in Apache Parquet with full metadata attribution.
            </p>
          </div>
          <div class="arch-action">
            <a href="/docs/solace-dataset-guide" class="btn btn-sm">
              <div class="btn-inner">
                <span class="btn-text">Datasets</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
          </div>
        </div>

        <div class="arch-row">
          <div class="arch-index mono">02</div>
          <div class="arch-main">
            <h3>Sub-8B Quantized Student Models</h3>
            <p>
              Activation-calibrated student weights available in FP8, INT4 AWQ, and GGUF formats. Engineered to deliver near-lossless reasoning recovery on consumer devices.
            </p>
          </div>
          <div class="arch-action">
            <a href="/docs/quantized-models-quickstart" class="btn btn-sm">
              <div class="btn-inner">
                <span class="btn-text">Models</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
          </div>
        </div>

        <div class="arch-row">
          <div class="arch-index mono">03</div>
          <div class="arch-main">
            <h3>Anvil & TurboQuant Inference Engines</h3>
            <p>
              High-performance inference engines integrating Google TurboQuant FWHT-rotated KV cache compression (4.6x reduction) with Gemma 4 MTP and Qwen 3.6 NextN speculative decoding (+30-50% throughput).
            </p>
          </div>
          <div class="arch-action">
            <a href="/docs/turboquant-anvil-guide" class="btn btn-sm">
              <div class="btn-inner">
                <span class="btn-text">Anvil Engine</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
          </div>
        </div>

        <div class="arch-row">
          <div class="arch-index mono">04</div>
          <div class="arch-main">
            <h3>Empirical Research & Technical Reports</h3>
            <p>
              Peer-reviewed evaluation methodologies measuring reasoning degradation, KV cache optimization, and cross-architecture distillation transfer.
            </p>
          </div>
          <div class="arch-action">
            <a href="/papers" class="btn btn-sm">
              <div class="btn-inner">
                <span class="btn-text">Papers</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ 6. HARDWARE & COMPATIBILITY MATRIX ═══════════════ -->
  <section class="section border-bottom">
    <div class="container">
      <div class="section-head-split">
        <div>
          <span class="eyebrow">Hardware Acceleration</span>
          <h2>Silicon & Framework Compatibility Matrix</h2>
        </div>
        <p>
          Benchmarked across commodity workstations, Apple Silicon Metal, and enterprise data center GPUs.
        </p>
      </div>

      <div class="hardware-grid-list">
        {hardwareTiers.map((hw, idx) => (
          <div class="hw-row">
            <div class="hw-col-idx mono">0{idx + 1}</div>
