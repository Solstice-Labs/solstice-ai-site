---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — Solstice-AI Blog`}
  description={post.data.description}
>
  <div class="container blog-page-wrapper">
    <div class="blog-reader-header">
      <nav class="back-nav mono">
        <a href="/blog">← All Notes</a>
      </nav>

      <div class="blog-meta-strip mono">
        <time datetime={post.data.pubDate.toISOString()}>
          {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        {post.data.readingTime && <span>&bull; {post.data.readingTime}</span>}
      </div>

      <h1>{post.data.title}</h1>

      <div class="author-strip mono">
        By {post.data.author}
      </div>

      {post.data.takeaways && post.data.takeaways.length > 0 && (
        <div class="takeaways-box">
          <div class="takeaways-tag mono">KEY TAKEAWAYS</div>
          <ul class="takeaways-items">
            {post.data.takeaways.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="blog-reader-layout">
      <div class="post-markdown-body">
        <Content />
      </div>

      <footer class="post-reader-footer mono">
        <div class="post-tags-list">
          {post.data.tags.map((tag: string) => (
            <span class="tag-chip">#{tag}</span>
          ))}
        </div>
        <a href="/blog" class="back-btn">← Back to all notes</a>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .blog-page-wrapper {
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .blog-reader-header {
    padding: 48px 40px;
    border: var(--border);
    background: var(--negative);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .back-nav a {
    font-size: 0.8125rem;
    color: var(--positive-dim);
  }

  .back-nav a:hover {
    color: var(--positive);
  }

  .blog-meta-strip {
    font-size: 0.75rem;
    color: var(--positive-dim);
    display: flex;
    gap: 8px;
  }

  .blog-reader-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
  }

  .author-strip {
    font-size: 0.875rem;
    color: var(--positive-dim);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-muted);
  }

  .takeaways-box {
    background: repeating-linear-gradient(
      -58deg,
      rgba(206, 190, 190, 0.08) 0 1px,
      transparent 1px 12px
    );
    border: var(--border);
    border-left: 3px solid var(--rose);
    border-top-left-radius: 12px 18px;
    border-bottom-right-radius: 12px 18px;
    padding: 24px;
    margin-top: 8px;
  }

  .takeaways-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--rose);
    margin-bottom: 8px;
  }

  .takeaways-items {
    margin-left: 20px;
    font-size: 0.95rem;
    color: var(--positive);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .blog-reader-container {
    padding: 0 0 96px;
  }

  .blog-reader-layout {
    border-left: var(--border);
    border-right: var(--border);
    border-bottom: var(--border);
    padding: 56px 48px;
    background: var(--negative);
  }

  .post-markdown-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--positive);
    max-width: 820px;
  }

  .post-markdown-body :global(h2) {
    font-size: 1.5rem;
    margin: 48px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-muted);
  }

  .post-markdown-body :global(h3) {
    font-size: 1.25rem;
    margin: 36px 0 12px;
  }

  .post-markdown-body :global(p) {
    margin-bottom: 20px;
    color: var(--positive-muted);
  }

  .post-markdown-body :global(pre) {
    background: #14171d;
    border: var(--border);
    padding: 20px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin: 24px 0;
  }

  .post-markdown-body :global(code) {
    font-family: var(--font-mono);
  }

  .post-reader-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 56px;
    padding-top: 24px;
    border-top: var(--border);
    font-size: 0.8125rem;
  }

  .post-tags-list {
    display: flex;
    gap: 8px;
    color: var(--positive-dim);
  }

  .back-btn {
    color: var(--positive);
  }

  .back-btn:hover {
    color: var(--rose);
  }

  @media (max-width: 768px) {
    .blog-reader-header {
      padding: 32px 20px;
    }
    .blog-reader-layout {
      padding: 32px 20px;
    }
  }
</style>
