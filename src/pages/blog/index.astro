---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Engineering Blog — Solstice-AI"
  description="Technical notes, release logs, and distillation research from Solstice-AI."
>
  <div class="container blog-page-wrapper">
    <div class="page-title-banner">
      <span class="eyebrow">ENGINEERING &bull; NOTES &bull; RELEASES</span>
      <h1>Blog & Technical Notes</h1>
      <p class="page-summary">
        Deep-dives on multi-teacher distillation, activation quantization, dataset verification, and open AI infrastructure.
      </p>
    </div>

    <div class="blog-grid-list">
      {sortedPosts.map((post) => (
        <article class="blog-entry-row">
          <div class="blog-entry-date mono">
            <time datetime={post.data.pubDate.toISOString()}>
              {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            {post.data.readingTime && <span class="read-tag">&bull; {post.data.readingTime}</span>}
          </div>

          <div class="blog-entry-body">
            <h2>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <div class="blog-entry-tags mono">
              {post.data.tags.map((tag) => (
                <span class="tag-chip">#{tag}</span>
              ))}
            </div>
          </div>

          <div class="blog-entry-cta">
            <a href={`/blog/${post.id}`} class="btn btn-sm">
              <div class="btn-inner">
                <span class="btn-text">Read</span>
                <span class="btn-arrow">→</span>
              </div>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .blog-page-wrapper {
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .page-title-banner {
    padding: 64px 40px 48px;
    border: var(--border);
    background: var(--negative);
  }

  .page-title-banner h1 {
    margin: 8px 0 16px;
  }

  .page-summary {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--positive-muted);
    max-width: 840px;
  }

  .blog-grid-list {
    display: flex;
    flex-direction: column;
    border-left: var(--border);
    border-right: var(--border);
    border-bottom: var(--border);
  }

  .blog-entry-row {
    display: grid;
    grid-template-columns: 180px 1fr 120px;
    align-items: baseline;
    gap: 32px;
    padding: 36px 40px;
    border-bottom: var(--border);
    background: var(--negative);
    transition: background 0.15s ease;
  }

  .blog-entry-row:last-child {
    border-bottom: none;
  }

  .blog-entry-row:hover {
    background: rgba(232, 228, 223, 0.02);
  }

  .blog-entry-date {
    font-size: 0.8125rem;
    color: var(--positive-dim);
  }

  .blog-entry-body h2 {
    font-size: 1.4rem;
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .blog-entry-body h2 a:hover {
    color: var(--rose);
  }

  .blog-entry-body p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--positive-muted);
  }

  .blog-entry-tags {
    display: flex;
    gap: 10px;
    font-size: 0.75rem;
    color: var(--positive-dim);
    margin-top: 10px;
  }

  .blog-entry-cta {
    text-align: right;
  }

  @media (max-width: 900px) {
    .blog-entry-row {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 28px 20px;
    }

    .blog-entry-cta {
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .page-title-banner {
      padding: 32px 20px;
    }
  }
</style>
